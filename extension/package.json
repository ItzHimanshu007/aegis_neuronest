{
  "name": "aegis-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt --browser chrome",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "pree2e": "wxt build --browser chrome",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "dom-accessibility-api": "^0.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4",
    "happy-dom": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "js-yaml": "^5.4.2"
  }
}