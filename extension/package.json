{
  "name": "aegis-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt --browser chrome",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "pree2e": "wxt build --browser chrome",
    "e2e": "playwright test",
    "predemo": "wxt build --browser chrome",
    "demo": "playwright test --config=playwright.demo.config.ts",
    "demo:live": "wxt build --browser chrome && AEGIS_DEMO_LIVE=1 playwright test --config=playwright.demo.config.ts",
    "eval:fsr": "wxt build --browser chrome && playwright test --config=playwright.eval.config.ts",
    "evidence:fixtures": "wxt build --browser chrome && playwright test --config=playwright.evidence.config.ts mask-label-fixtures",
    "evidence:screenshots": "wxt build --browser chrome && playwright test --config=playwright.evidence.config.ts mask-label-screenshots"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.1",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.5",
    "js-yaml": "^5.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}