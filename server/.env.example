# Aegis server configuration (Stage 3A; hosted-inference options added Stage 3B).
#
# Copy to server/.env and edit. `.env` is gitignored and must never be committed. This file
# (`.env.example`) is the only one of the two that is tracked — it must never hold a real key,
# only the placeholder/comment form below. `pnpm check` does not enforce this file staying a
# placeholder; it is enforced by review and by `git log --all -- server/.env` staying empty.
# Nothing in here reaches the extension: the API key is read by the server, used only in the
# Authorization header to the model endpoint, and never logged or returned in a response
# (server/tests/test_adapter.py asserts this, including that it never appears in the outbound
# request body or in the per-call metrics record).

# ---------------------------------------------------------------------------------------------
# Adapter
# ---------------------------------------------------------------------------------------------
# mock           deterministic, no network, used by pnpm check and the e2e suite (default)
# openai_compat  a real OpenAI-compatible /chat/completions endpoint
AEGIS_ADAPTER=mock

# ---------------------------------------------------------------------------------------------
# Model endpoint (only read when AEGIS_ADAPTER=openai_compat)
# ---------------------------------------------------------------------------------------------
# Ollama, local:     http://localhost:11434/v1   (no API key needed) — the default below. This is
#                    what every live-model figure in docs/deck-facts.md was measured against.
#                    NOTE (2026-09-21): qwen2.5vl:7b is NO LONGER INSTALLED — it was removed to
#                    reclaim disk, so no Ollama model is present on this host at all. The §3.5
#                    figures stand as a record of what was measured, but reproducing them (or
#                    using this default at all) now requires re-pulling first:
#                        ollama pull qwen2.5vl:7b        # ~6 GB
#                    Until then the only working live path is a hosted provider below.
# vLLM, local:       http://localhost:8000/v1    (no API key needed)
#
# Hosted, open-weight VLM (SIH26171 permits cloud-hosted open-weight/open-source models). Both
# providers below are wired the same way — pick one by setting AEGIS_LLM_BASE_URL/MODEL to its
# pair, no code change either way — and swapping between them is just re-editing these two lines:
#   Groq:       AEGIS_LLM_BASE_URL=https://api.groq.com/openai/v1
#               AEGIS_LLM_MODEL=qwen/qwen3.8-27b
#               Groq's only vision-capable model on the standard API as of 2026-09-20. Open-weight
#               (https://huggingface.co/Qwen/Qwen3.8-27B). Much faster (LPU inference — this is
#               the latency win). Caveat: "Preview" status, not "Production" — its predecessor
#               (qwen/qwen3.6-27b) was deprecated only 6 days before this was written, and Groq's
#               earlier vision models (Llama 4 Scout/Maverick) are already shut down entirely.
#               Re-check console.groq.com/docs/models before relying on this for a demo.
#   OpenRouter: AEGIS_LLM_BASE_URL=https://openrouter.ai/api/v1
#               AEGIS_LLM_MODEL=qwen/qwen-2.5-vl-7b-instruct:free
#               Same model family as the local Ollama baseline (qwen2.5vl:7b) — a cleaner
#               apples-to-apples comparison, and a steadier target if Groq's vision model is
#               ever pulled without a replacement lined up. Slower than Groq's LPU inference.
# Get an API key from the provider's console and put it in AEGIS_LLM_API_KEY below. Never commit it
# — see the API key hygiene note at the top of this file.
AEGIS_LLM_BASE_URL=http://localhost:11434/v1

# The model id as the endpoint names it. It must accept image input.
AEGIS_LLM_MODEL=qwen2.5vl:7b

# Leave unset for a local runtime. Required by hosted providers.
# AEGIS_LLM_API_KEY=

AEGIS_LLM_TIMEOUT_S=90
AEGIS_LLM_MAX_TOKENS=1024
# 0 for reproducible plans. Raise it only when deliberately measuring variance.
AEGIS_LLM_TEMPERATURE=0

# json_schema  strictest; use it where the provider supports it
# json_object  widely supported fallback (default)
# none         rely on the prompt alone; the repair pass is what catches the fallout
AEGIS_LLM_JSON_MODE=json_object

# Passed through as image_url.detail. auto | low | high
AEGIS_LLM_IMAGE_DETAIL=auto

# ---------------------------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------------------------
# How long a task's sanitized history survives without activity. POST /v1/session/end deletes one
# immediately; this is the backstop for a client that never calls it.
AEGIS_SESSION_TTL_S=900

# ---------------------------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------------------------
# Comma-separated origins. Empty (the default) disables the CORS middleware entirely.
AEGIS_CORS_ORIGINS=
