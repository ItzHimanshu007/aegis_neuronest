{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schema/plan.v1.schema.json",
  "title": "PlanV1",
  "description": "Server response. The server only PROPOSES: the extension validates, reacquires, re-hydrates and executes. Exactly one of plan, answer or extract is present.",
  "oneOf": [
    { "$ref": "#/$defs/planResponse" },
    { "$ref": "#/$defs/answerResponse" },
    { "$ref": "#/$defs/extractResponse" }
  ],
  "$defs": {
    "planResponse": {
      "title": "PlanResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["plan"],
      "properties": {
        "plan": {
          "type": "array",
          "description": "A batch of actions to attempt in order.",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "answerResponse": {
      "title": "AnswerResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["answer"],
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        }
      }
    },
    "extractResponse": {
      "title": "ExtractResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["extract"],
      "properties": {
        "extract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data"],
          "properties": { "data": { "type": "object", "additionalProperties": true } }
        }
      }
    },
    "actionName": {
      "type": "string",
      "enum": ["click", "type", "select", "check", "scroll", "hover", "key", "wait", "navigate", "ask_user", "done", "fail"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark_id", "fp"],
      "properties": {
        "mark_id": { "type": "integer", "minimum": 0 },
        "fp": { "type": "string", "minLength": 1, "description": "Fingerprint from the payload. The extension refuses to act if the reacquired element's fingerprint does not match." }
      }
    },
    "expect": {
      "type": "object",
      "description": "Post-condition checked locally after the action. All fields optional.",
      "additionalProperties": false,
      "properties": {
        "mark_id": { "type": "integer", "minimum": 0 },
        "has_value": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "modal_open": { "type": "boolean" },
        "url_path_prefix": { "type": "string" }
      }
    },
    "action": {
      "title": "Action",
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/$defs/actionName" },
        "target": { "$ref": "#/$defs/target" },
        "text": { "type": "string", "description": "type only. May contain [[PII:TYPE:xxxxxxxx]] tokens, re-hydrated locally under strict rules." },
        "value": { "type": "string", "description": "select only." },
        "direction": { "type": "string", "enum": ["up", "down"], "description": "scroll only." },
        "amount": { "type": "integer", "description": "scroll only." },
        "key": { "type": "string", "description": "key only." },
        "ms": { "type": "integer", "minimum": 0, "description": "wait only." },
        "url": { "type": "string", "description": "navigate only. Never re-hydrated." },
        "reason": { "type": "string", "description": "Human-readable justification. Required for ask_user and fail." },
        "expect": { "$ref": "#/$defs/expect" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["click", "type", "select", "check", "hover"] } }, "required": ["action"] },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "action": { "const": "type" } }, "required": ["action"] },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "action": { "const": "select" } }, "required": ["action"] },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "action": { "const": "scroll" } }, "required": ["action"] },
          "then": { "required": ["direction", "amount"] }
        },
        {
          "if": { "properties": { "action": { "const": "key" } }, "required": ["action"] },
          "then": { "required": ["key"] }
        },
        {
          "if": { "properties": { "action": { "const": "wait" } }, "required": ["action"] },
          "then": { "required": ["ms"] }
        },
        {
          "if": { "properties": { "action": { "const": "navigate" } }, "required": ["action"] },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "action": { "enum": ["ask_user", "fail"] } }, "required": ["action"] },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
