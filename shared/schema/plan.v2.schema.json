{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schema/plan.v2.schema.json",
  "title": "PlanV2",
  "description": "Untrusted server response: exactly one of plan, answer, extract or request_context; bound to the latest sealed state.",
  "oneOf": [
    {
      "$ref": "#/$defs/planResponse"
    },
    {
      "$ref": "#/$defs/answerResponse"
    },
    {
      "$ref": "#/$defs/extractResponse"
    },
    {
      "$ref": "#/$defs/contextResponse"
    }
  ],
  "$defs": {
    "planResponse": {
      "title": "PlanResponse",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "state_token",
        "schema"
      ],
      "properties": {
        "plan": {
          "type": "array",
          "description": "A batch of actions to attempt in order.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "schema": {
          "const": "aegis/2"
        },
        "state_token": {
          "type": "string",
          "pattern": "^S[a-z2-7]{10}$"
        },
        "plan_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "answerResponse": {
      "title": "AnswerResponse",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "state_token",
        "schema"
      ],
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "schema": {
          "const": "aegis/2"
        },
        "state_token": {
          "type": "string",
          "pattern": "^S[a-z2-7]{10}$"
        },
        "plan_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "extractResponse": {
      "title": "ExtractResponse",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extract",
        "state_token",
        "schema"
      ],
      "properties": {
        "extract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "schema": {
          "const": "aegis/2"
        },
        "state_token": {
          "type": "string",
          "pattern": "^S[a-z2-7]{10}$"
        },
        "plan_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "actionName": {
      "type": "string",
      "enum": [
        "click",
        "type",
        "select",
        "check",
        "scroll",
        "hover",
        "key",
        "wait",
        "navigate",
        "ask_user",
        "done",
        "fail"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eid",
        "fp"
      ],
      "properties": {
        "fp": {
          "type": "string",
          "minLength": 1,
          "description": "Fingerprint from the payload. The extension refuses to act if the reacquired element's fingerprint does not match."
        },
        "eid": {
          "type": "string",
          "pattern": "^E[0-9]{1,6}$"
        }
      }
    },
    "expect": {
      "type": "object",
      "description": "Post-condition checked locally after the action. All fields optional.",
      "additionalProperties": false,
      "properties": {
        "has_value": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "modal_open": {
          "type": "boolean"
        },
        "url_path_prefix": {
          "type": "string"
        },
        "eid": {
          "type": "string",
          "pattern": "^E[0-9]{1,6}$"
        },
        "no_validation_error": {
          "type": "boolean"
        },
        "text_present": {
          "type": "string",
          "maxLength": 500
        }
      },
      "minProperties": 1
    },
    "action": {
      "title": "Action",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/actionName"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "text": {
          "type": "string",
          "description": "type only. May contain [[PII:TYPE:xxxxxxxx]] tokens, re-hydrated locally under strict rules."
        },
        "value": {
          "type": "string",
          "description": "select only."
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ],
          "description": "scroll only."
        },
        "amount": {
          "type": "integer",
          "description": "scroll only."
        },
        "key": {
          "type": "string",
          "description": "key only."
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "description": "wait only."
        },
        "url": {
          "type": "string",
          "description": "navigate only. Never re-hydrated."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable justification. Required for ask_user and fail."
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "evidence": {
          "$ref": "#/$defs/expect"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "click",
                  "type",
                  "select",
                  "check",
                  "hover"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "type"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "select"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "scroll"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "direction",
              "amount"
            ]
          }
        },
        {
