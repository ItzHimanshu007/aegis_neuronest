              "action": {
                "const": "wait"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "ms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "navigate"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "ask_user",
                  "fail"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
